# Codecov API access token (Settings → Access → Generate Token).
# Not the per-repo CI upload token.
CODECOV_TOKEN=

# Optional API base override.
# CODECOV_API_URL=https://api.codecov.io/api/v2

# Optional MCP Streamable HTTP (default off / stdio).
# MCP_HTTP=true
# CODECOV_MCP_ADDR=127.0.0.1:8690
